HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=https://aos-admin.example.com
UPSTREAM_BASE_URL=http://automation-os.zeabur.internal:8080
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=<secret-manager-reference-or-value>
OIDC_CLIENT_SECRET=<secret-manager-reference-or-value>
OIDC_ALLOWED_EMAILS=owner@example.com
PROXY_SESSION_SECRET=<32-byte-secret>
AOS_PRIVATE_INGRESS_SECRET=<same-secret-as-AOS-service>
COOKIE_SECURE=1
