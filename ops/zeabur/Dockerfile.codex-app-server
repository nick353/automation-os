FROM node:22-bookworm-slim

ARG CODEX_CLI_VERSION=0.145.0
ENV CODEX_APP_SERVER_PORT=4500
ENV CODEX_HOME=/data/codex
WORKDIR /app

# The current Docker builder's unprivileged _apt method reports false invalid
# signatures even though direct gpgv verifies the same Debian InRelease. Keep
# signature/TLS verification enabled; only make the build-time apt method
# explicit. This does not change the runtime Codex sandbox (bubblewrap).
RUN apt-get -o APT::Sandbox::User=root update \
  && apt-get -o APT::Sandbox::User=root install --yes --no-install-recommends bubblewrap ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global "@openai/codex@${CODEX_CLI_VERSION}"

COPY ops/zeabur/start-codex-app-server.sh /usr/local/bin/start-codex-app-server
RUN chmod 0755 /usr/local/bin/start-codex-app-server \
  && mkdir -p /data/codex

EXPOSE 4500
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD node -e 'fetch(`http://127.0.0.1:${process.env.PORT || process.env.CODEX_APP_SERVER_PORT || 4500}/readyz`).then(r => process.exit(r.status === 200 ? 0 : 1)).catch(() => process.exit(1))'

ENTRYPOINT ["/usr/local/bin/start-codex-app-server"]
