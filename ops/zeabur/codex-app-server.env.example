# Dedicated Zeabur Codex App Server service
CODEX_HOME=/data/codex
CODEX_APP_SERVER_PORT=4500
# Mount this path from the Zeabur secret manager; never commit a real value.
CODEX_APP_SERVER_TOKEN_FILE=/run/secrets/codex-app-server-token
# Loopback is the fail-closed default. A non-loopback listener requires an
# approved private ingress and TLS termination on the host platform.
CODEX_APP_SERVER_BIND_HOST=127.0.0.1
# Set both to 1 only after the private ingress and TLS boundary are approved.
CODEX_APP_SERVER_NON_LOOPBACK_APPROVED=0
CODEX_APP_SERVER_TLS_TERMINATED=0

# Automation OS service, not the dedicated server image. Keep the token in the
# same approved secret manager and do not put it in logs or ordinary Postgres.
# Zeabur AOS service only: private service-to-service route. Do not use this
# internal hostname from the Mac worker and do not enable it outside Zeabur.
AUTOMATION_OS_CODEX_APP_SERVER_REMOTE_URL=ws://codex-app-server.zeabur.internal:8080/
AUTOMATION_OS_CODEX_APP_SERVER_ALLOW_INTERNAL_WS=1
AUTOMATION_OS_CODEX_APP_SERVER_REMOTE_TOKEN=<secret-manager-only>
# Or point the AOS service at a 0400 secret-manager file. The file value is
# never placed in ordinary environment readback or the command line.
AUTOMATION_OS_CODEX_APP_SERVER_REMOTE_TOKEN_FILE=/run/secrets/aos-codex-app-server-token
AUTOMATION_OS_CODEX_APP_SERVER_REMOTE_CWD=/app
