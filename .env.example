# Automation OS local configuration template.
# Copy to .env for local use. Never commit real secrets or session tokens.

AUTOMATION_OS_PORT=8787
AUTOMATION_OS_DB=./data/automation-os.sqlite
AUTOMATION_OS_ARTIFACT_ROOT=./data/artifacts
AUTOMATION_OS_RESUME_CONTRACT_PATH=./data/resume-contract.json

# Preferred production database. If set, this overrides AUTOMATION_OS_DB and
# uses PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/database
# AUTOMATION_OS_DATABASE_URL=postgresql://user:password@host:5432/database

# Database authority boundary. Leave unset for legacy local behavior. Set
# AUTOMATION_OS_ENV_ROLE=production on the hosted control plane so a missing
# or invalid PostgreSQL configuration fails before SQLite/server startup. The
# Mac login-recovery LaunchAgent uses AUTOMATION_OS_ENV_ROLE=recovery and may
# keep its explicit SQLite fallback. Never put a real URL or secret here.
# AUTOMATION_OS_ENV_ROLE=production

# Production safety. When PORT is present, Automation OS locks POST/PATCH/PUT/DELETE
# by default unless this token is configured and sent as x-automation-os-token.
# Set AUTOMATION_OS_REQUIRE_WRITE_TOKEN=0 only for a private, isolated service.
AUTOMATION_OS_REQUIRE_WRITE_TOKEN=1
# AUTOMATION_OS_WRITE_TOKEN=
# Read-only production QA/replay readback. Set exactly one in the host secret
# manager; never commit or paste the value into source, logs, or chat.
# AUTOMATION_OS_READ_TOKEN=
# AUTOMATION_OS_QA_READ_TOKEN=
# AUTOMATION_OS_REPLAY_READ_TOKEN=

# Browser Use runtime ownership. Hosted Zeabur is the control plane and must
# wait for a same-run Mac worker readback; only the dedicated worker may mark
# its canonical helper verified after local admission checks.
AUTOMATION_OS_RUNTIME_ROLE=control_plane
AUTOMATION_OS_BROWSER_USE_RUNTIME_VERIFIED=0

# Optional local tool overrides. Browser-backed automation is Browser Use CLI
# only; do not set a Playwright, direct Chrome, or direct CDP runner here.
# Leave the generic override empty so the LaunchAgent's official
# CODEX_CLI_PATH is selected. Set this only to an explicitly verified
# official Codex CLI executable when a local override is intentional.
# AUTOMATION_OS_CODEX_BIN=
AUTOMATION_OS_NODE_BIN=node
AUTOMATION_OS_BROWSER_USE_HELPER=/Users/nichikatanaka/.local/bin/codex-browser-use
AUTOMATION_OS_BROWSER_USE_RUNTIME_CONFIG=/Users/nichikatanaka/.browser-use-cli/browser-use-runtime.toml

# Optional workflow-owned Browser Use CLI adapters. An unset adapter is a
# deliberate fail-closed state; there is no Playwright/Chrome/CDP fallback.
# AUTOMATION_OS_DAILY_AI_BROWSER_USE_RUNNER=
# AUTOMATION_OS_NISENPRINTS_BROWSER_USE_RUNNER=
# AUTOMATION_OS_PROMPT_TRANSFER_BROWSER_USE_RUNNER=
# AUTOMATION_OS_SNS_MULTI_POSTER_BROWSER_USE_RUNNER=

# Browser Use CLI allocates and binds the current-run profile/port from its
# authority and descriptor. Do not preconfigure a shared Chrome/CDP lane.

# Secrets belong in the local secret store or your shell, never in Git.
# Create chat planner. "auto" uses local Codex CLI on local Mac runs, and local
# fallback in production-like hosts. Set "openai" only when API billing is OK.
# AUTOMATION_OS_CREATE_PLANNER_PROVIDER=auto
# AUTOMATION_OS_CODEX_PLANNER_BIN=codex
# AUTOMATION_OS_CODEX_PLANNER_TIMEOUT_MS=25000
# OPENAI_API_KEY=
# OPENAI_PLANNER_MODEL=gpt-4o-mini
# PRINTIFY_API_KEY=
# RUNWAY_API_KEY=
